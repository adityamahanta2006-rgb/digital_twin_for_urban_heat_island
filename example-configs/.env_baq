COMPOSE_PROJECT_NAME="udt-baq"

# Configuration for data download
EXTENT="-74.8545664292199433,10.8298732935428710,-74.7296433228420653,11.0334877976169139"
EXTENT_CRS="EPSG:4326"
RUNNING_IN_DOCKER=1
DOWNLOAD_BASE_DATA=1
BUILDING_DATASET="globfp"
URBAN_AREA_NAME="Barranquilla"

# Web image variables
HOST_HTTP_WEB_PORT="8000"
HOST_HTTPS_WEB_PORT="8001"
WEB_WORKERS="5"
WEB_TIMEOUT="120"
ROSE_API_BASE_URL="http://localhost:8000"

# Processing results storage
HOST_OUTPUT_DIR="/home/user/Desktop/UDT_BAQ/results"
HOST_PROCESSING_DIR="/home/user/Desktop/UDT_BAQ/processes"
HOST_STORAGE_DIR="/home/user/Desktop/UDT_BAQ/data_dir"

# Connection to the database
HOST_DB_PORT="5430"

# Django default superuser
DJANGO_SUPERUSER_USERNAME="admin"
DJANGO_SUPERUSER_PASSWORD="roseapi123"
DJANGO_SUPERUSER_EMAIL="example@example.com"

# RabbitMQ and Celery variables
RABBITMQ_DEFAULT_USER="admin"
RABBITMQ_DEFAULT_PASS="roseapi123"

# Local Variables - from /roseapi/.env
DEBUG=False
DJANGO_SECRET_KEY="^ac1hag-+oer0tfn!ir*s71rc0320n*-cdziqj#g+5dnypg@k"
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_DB="roseapi"
POSTGRES_USER="roseapi"
POSTGRES_PASSWORD="roseapi123"
CELERY_BROKER_URL="amqp://admin:roseapi123@rabbitmq:5672"

# GeoServer variables
HOST_GEOSERVER_PORT="8081"
HOST_GEOSERVER_BASE_URL="http://localhost:8081"
GEOSERVER_ADMIN_PASSWORD="geoserver123"
GEOSERVER_ADMIN_USER="admin"
COMMUNITY_EXTENSIONS="cog-http-plugin,importer-plugin"
STABLE_EXTENSIONS="ogcapi-features-plugin"
FORCE_DOWNLOAD_COMMUNITY_EXTENSIONS=true
GEOSERVER_DATA_DIR="/data_dir"

# RabbitMQ variables
HOST_RABBITMQ_PORT="5672"
HOST_RABBITMQ_MANAGEMENT_PORT="15672"

# Piero Frontend variables
HOST_FRONTEND_PORT="8080"
HOST_FRONTEND_BASE_URL="http://localhost:8080"
HOST_FRONTEND_PROD=true

# UDT Assembler variables
UDTDB_DB="udt_data"
UDTDB_USER="udt"
UDTDB_PASSWORD="userudt"
